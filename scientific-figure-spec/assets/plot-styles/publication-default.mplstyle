font.family: sans-serif
font.sans-serif: DejaVu Sans, Arial, Liberation Sans
font.size: 8
axes.labelsize: 8
axes.titlesize: 9
axes.linewidth: 0.8
xtick.labelsize: 7
ytick.labelsize: 7
legend.fontsize: 7
