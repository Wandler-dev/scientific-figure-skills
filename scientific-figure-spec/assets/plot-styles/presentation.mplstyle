font.family: sans-serif
font.sans-serif: DejaVu Sans, Arial, Liberation Sans
font.size: 12
axes.labelsize: 12
axes.titlesize: 14
axes.linewidth: 1.0
xtick.labelsize: 10
ytick.labelsize: 10
legend.fontsize: 10
